{
  "name": "dhaka-tesla-pool",
  "version": "0.1.0",
  "private": true,
  "description": "Ride-pooling MVP foundation for Dhaka traffic.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=@dhaka-tesla-pool/web -- --port 3001",
    "dev:api": "npm run start:dev --workspace=@dhaka-tesla-pool/api",
    "build:web": "npm run build --workspace=@dhaka-tesla-pool/web",
    "build:api": "npm run build --workspace=@dhaka-tesla-pool/api",
    "lint:web": "npm run lint --workspace=@dhaka-tesla-pool/web",
    "lint:api": "npm run lint --workspace=@dhaka-tesla-pool/api"
  }
}
